# PayPal sandbox credentials. Leave the id and secret empty to run in mock mode.
# Never commit real values. Copy this file to .env.local.

PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox personal-account email that should receive the invoice.
# Required before Send works against the sandbox. The placeholder is only for mock mode.
PAYPAL_RECIPIENT_EMAIL=

# Optional. Shown on the invoice as the merchant email when set.
PAYPAL_INVOICER_EMAIL=
